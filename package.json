{
  "name": "meigen",
  "version": "4.0.0",
  "config": {
    "distributionNpmVersion": "4.0.0",
    "legacyNpmVersion": "3.4.0",
    "remoteMcpUrl": "https://www.meigen.ai/api/mcp"
  },
  "description": "Remote MeiGen MCP connection bridge: hosted tools, OAuth and legacy API-key compatibility",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "meigen": "bin/meigen-mcp.js",
    "meigen-mcp": "bin/meigen-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "SETUP.md",
    "SETUP.zh-CN.md",
    "RELEASE_NOTES_4.0.0.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsx -e \"import { main } from './src/index.ts'; void main(process.argv.slice(1))\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --import tsx --test test/*.test.mjs && node --test scripts/ci/*.test.mjs",
    "prepack": "pnpm run build",
    "release:check": "node scripts/release.mjs check",
    "release:dry-run": "node scripts/release.mjs dry-run",
    "release:publish": "node scripts/release.mjs publish",
    "release:stage": "node scripts/release.mjs stage",
    "check:remote": "node scripts/ci/check-remote.mjs"
  },
  "keywords": [
    "mcp",
    "ai",
    "image-generation",
    "claude",
    "meigen",
    "prompt-engineering"
  ],
  "author": {
    "name": "MeiGen",
    "url": "https://www.meigen.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jau123/MeiGen-AI-Design-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/jau123/MeiGen-AI-Design-MCP/issues"
  },
  "homepage": "https://github.com/jau123/MeiGen-AI-Design-MCP#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "volta": {
    "node": "24.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "mcp-remote": "0.16.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@10.18.3"
}
