{
  "name": "meigen",
  "version": "3.0.0",
  "description": "Composable image and video generation tools, reusable visual skills, and optional creative workflows for MCP clients",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "meigen": "bin/meigen-mcp.js",
    "meigen-mcp": "bin/meigen-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "SETUP.md",
    "SETUP.zh-CN.md",
    "SKILLS_API.md",
    "COMPOSABLE_WORKFLOWS.md",
    "COMPOSABLE_WORKFLOWS.zh-CN.md",
    "MCP_AUTH_AND_RESULTS.md",
    "RELEASE_NOTES_3.0.0.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.mjs && node --import tsx --test src/tools/*.test.mjs && node --test scripts/ci/*.test.mjs",
    "prepack": "pnpm run build",
    "release:check": "node scripts/release.mjs check",
    "release:dry-run": "node scripts/release.mjs dry-run",
    "release:publish": "node scripts/release.mjs publish",
    "release:stage": "node scripts/release.mjs stage"
  },
  "keywords": [
    "mcp",
    "ai",
    "image-generation",
    "claude",
    "meigen",
    "prompt-engineering"
  ],
  "author": {
    "name": "MeiGen",
    "url": "https://www.meigen.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jau123/MeiGen-AI-Design-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/jau123/MeiGen-AI-Design-MCP/issues"
  },
  "homepage": "https://github.com/jau123/MeiGen-AI-Design-MCP#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "24.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
